# Pinned versions of the build and compliance tools that Dependabot cannot see.
# Read by the license scripts, scripts/install-dev-tools.sh, the Linux package smoke test and
# the workflows. The Tool versions workflow bumps them weekly in a PR.
# The Rust toolchain itself is pinned in rust-toolchain.toml (bumped by Dependabot).
CARGO_DENY_VERSION=0.20.2
CARGO_ABOUT_VERSION=0.9.1
CARGO_PACKAGER_VERSION=0.11.8
NFPM_VERSION=2.47.0
