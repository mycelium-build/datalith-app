# Pinned versions of the build and compliance tools that no package manifest declares.
# Read by the license scripts (which install the missing ones, see scripts/lib/tools.sh), the
# Linux package smoke test and the workflows. Renovate bumps them in its "update tools" PR, from the comment above each line.
# The Rust toolchain itself is pinned in rust-toolchain.toml (also bumped by Renovate).
# renovate: datasource=crate depName=cargo-deny
CARGO_DENY_VERSION=0.20.2
# renovate: datasource=crate depName=cargo-about
CARGO_ABOUT_VERSION=0.9.3
# renovate: datasource=crate depName=cargo-packager
CARGO_PACKAGER_VERSION=0.11.8
# renovate: datasource=github-releases depName=goreleaser/nfpm extractVersion=^v(?<version>.+)$
NFPM_VERSION=2.48.0
# renovate: datasource=github-releases depName=russellbanks/Komac extractVersion=^v(?<version>.+)$
KOMAC_VERSION=2.17.2
