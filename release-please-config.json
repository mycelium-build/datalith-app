{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "970cafad8a80ee6a0e0ed84bb3a7abc9e524144f",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "extra-files": [
        "THIRD-PARTY-NOTICES.md",
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'datalith-core' || @.name.value == 'datalith-desktop' || @.name.value == 'datalith-server' || @.name.value == 'datalith-ui' || @.name.value == 'datalith-vault')].version"
        }
      ]
    }
  }
}
