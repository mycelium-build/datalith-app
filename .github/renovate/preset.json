{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate rules: ordinary releases wait three days and new PRs are scheduled on Tuesdays; security fixes skip the delay; existing PRs stay current with main.",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "* * * * 2"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "minimumReleaseAgePackageManagerSync": true,
  "npm": {
    "constraints": {
      "npm": ">=11.10.0 <12"
    },
    "npmrc": "min-release-age=3\n"
  },
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "updateNotScheduled": true,
  "prHourlyLimit": 0,
  "semanticCommits": "enabled",
  "commitMessageAction": "update",
  "dependencyDashboard": {
    "enabled": true
  },
  "automerge": false,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 2"
    ],
    "commitMessagePrefix": "chore(deps):",
    "commitMessageAction": "lock file maintenance"
  },
  "packageRules": [
    {
      "description": "Keep the Renovate runner's npm compatible with both Node repositories and its release-age setting.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "npm"
      ],
      "allowedVersions": ">=11.10.0 <12"
    },
    {
      "description": "Version updates ship in the app: fix(deps), one PR per update type.",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch dependencies",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor dependencies",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependencies",
      "groupSlug": "dependencies",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "description": "Dev-only dependencies do not ship: chore(deps), no release.",
      "matchDepTypes": [
        "dev-dependencies",
        "devDependencies"
      ],
      "groupName": "dev dependencies",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Build and CI tools (GitHub Actions, Rust toolchain, pinned tool versions): chore(deps), no release.",
      "matchManagers": [
        "github-actions",
        "rust-toolchain",
        "custom.regex"
      ],
      "groupName": "tools",
      "separateMajorMinor": false,
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "The gpui crates pin each other to exact versions: they can only move together.",
      "matchPackageNames": [
        "gpui-kit",
        "/^gpui-pre/"
      ],
      "groupName": "gpui",
      "separateMajorMinor": false,
      "commitMessagePrefix": "fix(deps):"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security fixes: checked daily without a release-age delay; prefer the lowest fixed version.",
    "groupName": "security updates",
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "npmrc": "min-release-age=0\n",
    "labels": [
      "security"
    ],
    "commitMessagePrefix": "fix(deps):",
    "vulnerabilityFixStrategy": "lowest"
  },
  "osvVulnerabilityAlerts": true
}
